# Copy this file to .env and fill in your key(s).
# Only the provider you use needs a key.

# Groq (free tier — https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Anthropic (paid — https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini (free tier — https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama: no key needed — just run `ollama serve` locally
